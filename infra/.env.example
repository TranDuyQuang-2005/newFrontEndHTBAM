# ==========================================================
# GEMINI LLM CONFIGURATION
# Copy file này thành infra/.env và thay placeholder bằng key thật.
#
# LẤY KEY:
# Google AI Studio -> API Keys
#
# TUYỆT ĐỐI KHÔNG COMMIT .env LÊN GIT
# ==========================================================

GEMINI_MODEL=gemini-3.5-flash-lite
ASPNETCORE_ENVIRONMENT=Development
# Demo seed chỉ chạy khi được bật rõ và môi trường là Development.
Seed__Development=true
# Seeder chỉ thêm dữ liệu thiếu; không đặt lại mật khẩu bản ghi đã có.
SEED_DEFAULT_PASSWORD=HTBAM-Local-Demo!2026#
# Phải khớp mật khẩu của volume SQL hiện hữu; đổi dòng này không reset mật khẩu SA.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# THAY KEY THẬT TẠI DÒNG DƯỚI:
GEMINI_API_KEY=PASTE_YOUR_REAL_GEMINI_API_KEY_HERE
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

